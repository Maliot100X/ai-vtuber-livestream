# ============================================
# AI VTuber Live Stream - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- LLM Configuration ----
# Any OpenAI-compatible API works (OpenRouter, Together, Groq, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ---- YouTube Live Stream ----
YOUTUBE_STREAM_KEY=your-youtube-stream-key
YOUTUBE_VIDEO_ID=your-live-video-id

# ---- Server Configuration ----
VTUBER_HOST=0.0.0.0
VTUBER_PORT=12393
VTUBER_PUBLIC_IP=your-server-public-ip

# ---- TTS Configuration ----
# Options: edge_tts, openai_tts, elevenlabs_tts, fish_api_tts
TTS_MODEL=edge_tts
TTS_VOICE=en-US-AvaMultilingualNeural

# ---- Optional: HeyGen API (for avatar videos) ----
# HEYGEN_API_KEY=your-heygen-api-key
