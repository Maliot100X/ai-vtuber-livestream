# ============================================
# AI VTuber Live Stream - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example ~/Open-LLM-VTuber/.env

# ---- LLM Configuration ----
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, Together, DeepSeek, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ---- YouTube Live Stream ----
# Get your stream key from: YouTube Studio → Go Live → Stream → Stream Key
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx
# Get video ID from your live stream URL: youtube.com/watch?v=VIDEO_ID
YOUTUBE_VIDEO_ID=your-live-video-id

# ---- Server Configuration ----
VTUBER_HOST=0.0.0.0
VTUBER_PORT=12393
# Your server's public IP (for Chrome to connect to)
VTUBER_PUBLIC_IP=your-server-public-ip

# ---- TTS Configuration ----
# Options: edge_tts, openai_tts, elevenlabs_tts, fish_api_tts, piper_tts, bark_tts
TTS_MODEL=edge_tts
TTS_VOICE=en-US-AvaMultilingualNeural

# ---- Optional: HeyGen API ----
# HEYGEN_API_KEY=your-heygen-api-key
